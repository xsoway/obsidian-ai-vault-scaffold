# Vault 环境配置模板
# 复制为 vault.env 并修改；initialize.sh 会读取并生成实际脚本配置。

# Vault 根目录（绝对路径，脚本默认回退到当前工作目录）
OBSIDIAN_VAULT_DIR=/Users/<you>/<your-vault>

# Python 运行时（需 Python 3.11+；macOS 可用 /opt/homebrew/bin/python3.13）
PYTHON=python3

# 定时任务日志目录（cron / launchd 输出）
LOG_DIR=${OBSIDIAN_VAULT_DIR}/70-System/70.06-Workflows/automation-runtime/logs
WIKI_LOG_DIR=${OBSIDIAN_VAULT_DIR}/71-Wiki/71-03-output

# 每周复盘配置
WEEKLY_REVIEW_DAYS=7

# 你的 git user.name（用于 daily-timesheet 统计当日提交）
GIT_AUTHOR_NAME=

# 可选：Obsidian CLI（用于 open / 跨应用联动）
# OBSIDIAN_CLI=obsidian-cli